//Functions and member variables
struct foo inherits X,Y,Z {
private let x: integer;
private let y: float;
private let z: id;
private let id: mytype;

public let x: integer;
public let x: float;
public let z: id;
public let x: mytype[123];
public let x: mytype[];


private func foo(x:integer[][], x: float[123][123], id: mytype[123][])->mytype;
public func foo(x:integer[123][123][123] , y: float, id: mytype[][]) ->mytype;


private func foo()->type;
private func foo() -> id;
private func foo() -> integer;
private func foo() -> float;
private func foo() -> id;

};



//Empty struct
struct foo {};


//Only data members.
struct foo {
private let x: foo;
private let x: integer;
private let x: float;
private let y: id;

};

//only function members.
struct foo{
private func foo(x: integer, y:float, z: identifier[][][123]) -> void;
private func foo(x:integer, y:float, z:type) -> integer;
private func foo(x: integer[666], y:float[666], z: identifier[666]) -> type;
private func foo() -> float;
};
//Function testing
//function head with array parameters and multiple paramers

func foo(x:integer, y:integer[][][][][][] , x: float[123], x: integer[][123][]) -> void{
doStuff();
f(g(h(x))).a[123][123][123].b=(1-2-3+(x*y*z)); //nesting identifiers ending with an assignment to a variable.
a.b.c.d.e.f.g.h.i.j.k.l.m.n.o.p.q.r.s.t.u.w.v.x.y.z.f(x); //nesting identifiers ending with a funciton call.

while(x<y){
while(x>y){
if(x > y) then {
if(x <> y) then {
doStuff();
}else{
  doStuff();
  };
doStuff();
}else{
  doStuff();
};
};
};



