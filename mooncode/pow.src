func pow(x: integer, p: integer)->integer{
   let i: integer;
   let j: integer;

   i=0;
   j=x;


   if(i==1) then {
    return(x);
    }else {
      while(i<p){
          x=x*j;
          i=i+1;
        };
        return(x);
      };
  }

func main()->void{
  let i: integer;
  while(i<100){
    write(pow(2,i));
    i=i+1;
    };

  }
