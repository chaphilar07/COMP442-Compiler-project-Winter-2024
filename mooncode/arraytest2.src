struct A{
    private let a:integer;
    private let b: integer;
  };


func main()->void{
  let arr: integer[10];
  let i: integer;
  let j: A;

  j.a=3;
  j.b=4;

  write(j.b+j.a);
  write(1+2+3+4+5);
  i=0;

  while(i<10){
    arr[i]=i+1;
    i=i+1;
  };

  i=0;
  while(i<10){
      if(arr[i]==(i+1)) then{
          write(1);
        }else{
            write(0);
        };
        i=i+1;
    };


  let x:integer;

  x=arr[arr[0]*2+arr[1]*2]; //arr[6]=7;
  write(x);

  

}
