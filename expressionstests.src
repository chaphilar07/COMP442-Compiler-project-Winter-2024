/*
 * This function computes a complex expression and returns it's value.
 */

func complex_expression(x: integer, y: integer, z: integer)->integer{
   return(x+y*z-(x*y)/z+x);
}
func another_complex_expression()->integer{
    return(((1+2)*3)/3);
  }








func complex_expression_with_relops(x:integer, y: integer, z: integer) -> void{
  if(x+y+z>=x*y*z) then {
      write(1);
    }else {
      write(0);
    };
}


func test_and_or(x: integer, y:integer)->void{
    let i: integer;
    i=x|y;
    write(i);
    i=x|y;
    write(i);
  }

  func test_eq(x: integer, y:integer)->void{
      if(x==y) then {
          write(1);
        }else{
            write(0);
        };
    }

  func test_neq(x: integer, y: integer)->void{
      if(x<>y)then{
          write(1);
        }else{
            write(0);
        };
    }

  func test_lt(x:integer, y:integer)->void{
      if(x<y) then {
          write(1);
        }else{
            write(0);
          };
    }

    func test_gt(x:integer, y:integer)->void{
        if(x>y) then {
            write(1);
          }else{
              write(0);
          };
      }
    func test_leq(x: integer, y: integer)->void{
        if(x<=y) then {
            write(1);
          }else{
              write(0);
          };
      }
      func test_geq(x:integer,y:integer)->void{
          if(x>=y)then{
              write(1);
            }else{
                write(0);
              };
        }




func main()->void{
    complex_expression_with_relops(1,2,3);
    complex_expression_with_relops(2,2,3);


   test_eq(0,0);
   test_eq(0,1);
   test_eq(1,0);
   test_eq(1,1);


   test_neq(0,0);
   test_neq(0,1);
   test_neq(1,0);
   test_neq(1,1);

   test_gt(0,0);
   test_gt(0,1);
   test_gt(1,0);
   test_gt(1,1);

   test_lt(0,0);
   test_lt(0,1);
   test_lt(1,0);
   test_lt(1,1);

   test_leq(0,0);
   test_leq(0,1);
   test_leq(1,0);
   test_leq(1,1);

   test_geq(0,0);
   test_geq(0,1);
   test_geq(1,0);
   test_geq(1,1);



   complex_expression_with_relops(1,2,3);
   complex_expression_with_relops(1,2,3);
   complex_expression_with_relops(1,2,3);

   write(another_complex_expression()); //Output should be 3.


    

  }
