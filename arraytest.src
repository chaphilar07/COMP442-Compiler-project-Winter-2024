func return1()->integer{
    return(1);
  }
func return2()->integer{
    return(2);
  }

func return3()->integer{
    return(3);
  }

func return4()->integer{
    return(4);
  }
func main()->void{

let x:integer;
let arr: integer[20];
let i:integer;

arr[0]=1;

x=1+2+3+4+5+6+7;

i=0;

//Simple while loop test.
while(i<20){
  arr[i]=i+1;
  write(arr[i]);
  x=x+arr[i];
  i=i+1;
  };


x=arr[0]+arr[1]+arr[2]+arr[3]+arr[4];

if(x==15) then {
    write(1);
  }else{
      write(0);
    };
 
write(x);

x=arr[arr[0]+arr[1]*arr[0]]*return2();  
write(x);

x=return1()+return2()+return3()+return4();
write(x);//10

x=arr[1+2+3+1+arr[1]];
write(x);//10

x=arr[arr[0]+arr[1]+arr[2]+arr[3]+arr[4]]; // 1+2+3+4+5 = 15 arr[15]=16.
write(x);


i=0;
while(i<10){
    read(arr[i]);
    i=i+1;
  };

i=0;
while(i<10){
  write(arr[i]);
  i=i+1;
  };



}




