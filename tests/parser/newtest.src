struct A{
    private let y:integer;
  };

struct B inherits A{
    private let x: float;
    private func foo()->B;
    private let a: A;
  };


impl B{
    func foo()->B{

      let z: B;
      z.a.y=3; // No error here but why?
      return (z.a.y);
      }
  }


  //Problem! For member variables, we always look at the current scope even if we should first be looking at the scope of the 
