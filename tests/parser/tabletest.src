//Test struct semantics in this section.

struct A inherits x,y,z{

private let a: integer;
private let b: integer;
private let c: integer;

private func overridden()->void;

private let x: integer;
private func x() -> void;
private let y: A; //legal
private func foo()->void; 

};

struct B inherits A{

private func overridden(a:integer, b:integer)->void;

private let a: float;
private let b: B;
private let c: D;
private let x: A;
private func foo(x:float) -> B;

};

struct C inherits B{
  private let a: D;
  private let b: B;
  private let c: float;

  private func defined(a:A,b:B, c:C)-> B;
  

};


