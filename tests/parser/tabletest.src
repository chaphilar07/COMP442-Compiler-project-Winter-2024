//Test struct semantics in this section.

struct A inherits x,y,z{
    private let x: integer;
    private func x() -> void;
    private let y: A; //legal
    private func foo()->void;
  };

struct B inherits A{

  private let x: A;
  private func foo() -> B;

  };

struct C inherits B{

  };


func foo()->float{
    return(0);
  }




